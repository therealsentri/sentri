<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sentri</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>sentri</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Heart rate from the fingertip: the camera flash + camera -->
	<key>NSCameraUsageDescription</key>
	<string>Sentri uses the camera to measure your heart rate from your fingertip.</string>
	<!-- Emergency alerts and location shares carry the person's position -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sentri shares your live location with the contacts you chose, during an emergency or a location share.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>During an emergency, Sentri keeps sharing your position with your chosen contacts until the alert ends.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>During an emergency, Sentri keeps sharing your position with your chosen contacts until the alert ends.</string>
	<!-- Health readings for the exercise and health history features -->
	<key>NSHealthShareUsageDescription</key>
	<string>Sentri reads your steps, heart rate and workouts to show your health and exercise history.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Sentri records workouts you start in the app so they appear in your health history.</string>
	<!-- The emergency push bell (remote-notification) and background position for
	     a running emergency (location). Background Modes must be enabled on the
	     App ID before App Store review - the Developer portal step, not code. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
